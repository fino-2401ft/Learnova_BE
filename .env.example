# Sao chép file này thành .env rồi điền giá trị thật.
# .env KHÔNG được commit — nó nằm trong .gitignore.

# --- Ứng dụng ---
NODE_ENV=development
PORT=3000
# Origin của frontend. Bắt buộc phải là origin cụ thể, KHÔNG dùng "*" —
# trình duyệt từ chối gửi cookie kèm request khi origin là ký tự đại diện.
CORS_ORIGIN=http://localhost:5173
# Gốc công khai của chính API này. Được ghép trước đường dẫn file tĩnh (ảnh cover
# khoá học) khi lưu URL vào database. Đổi cổng hoặc deploy lên domain thật thì phải
# đổi ở đây, rồi chạy lại seed để các URL đã lưu được cập nhật.
PUBLIC_BASE_URL=http://localhost:3000

# --- Cơ sở dữ liệu ---
# Máy đã cài sẵn PostgreSQL thì dùng localhost:5432.
# Chạy bằng Docker (docker compose up -d) thì cổng là 5433 để không đụng bản cài sẵn.
DATABASE_URL="postgresql://postgres:MAT_KHAU_CUA_BAN@localhost:5432/learnova?schema=public"

# --- Xác thực ---
# Sinh chuỗi mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-dai
# Thời gian sống của access token. Ngắn có chủ đích: token bị lộ chỉ dùng được
# trong khoảng này, và refresh token trong cookie mới là thứ giữ phiên đăng nhập.
JWT_ACCESS_TTL=900
# Thời gian sống của refresh token, tính bằng giây. 30 ngày.
# Cố định từ lúc đăng nhập, không gia hạn mỗi lần refresh.
REFRESH_TTL=2592000
# Tên cookie chứa refresh token.
REFRESH_COOKIE_NAME=learnova_rt

# --- File đính kèm trong chat ---
# File này là BẢN MẪU và được commit. Chỉ điền placeholder ở đây; giá trị thật để
# trong .env (đã nằm trong .gitignore).

# BẮT BUỘC. Ảnh và video đi Cloudinary.
# Lấy ở Dashboard → Product Environment Credentials (cloudinary.com/console).
# API secret là chữ ký của mọi lệnh upload: lộ nó là người khác upload được vào tài
# khoản của bạn. Không bao giờ đưa xuống frontend.
CLOUDINARY_CLOUD_NAME=ten-cloud-cua-ban
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=thay-bang-api-secret-that
# Tuỳ chọn. Thư mục gốc chứa file chat trên Cloudinary, mặc định learnova/chat.
# CLOUDINARY_FOLDER=learnova/chat

# TUỲ CHỌN. Supabase Storage giữ mọi file KHÔNG phải ảnh/video: pdf, docx, xlsx, zip.
#
# Bỏ trống cả ba dòng thì API vẫn chạy, gửi ảnh và video vẫn hoạt động, chỉ riêng gửi
# file thường trả về 503 kèm lời nhắn giải thích. Muốn bật thì phải điền ĐỦ cả ba —
# điền thiếu một dòng là API không khởi động, vì một cấu hình dở dang khó phát hiện
# hơn nhiều so với một cấu hình vắng mặt hẳn.
#
# Lấy ở Supabase → Project Settings → API. URL dạng https://<project-ref>.supabase.co
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# PHẢI là service_role key, KHÔNG phải anon key: anon key bị RLS chặn nên không ký
# được URL upload. Key này tương đương quyền quản trị toàn bộ project Supabase —
# chỉ để ở server, không commit, không đưa xuống frontend.
# SUPABASE_SERVICE_ROLE_KEY=thay-bang-service-role-key
# Tên bucket. Tự tạo trong Supabase → Storage → New bucket, đặt là PUBLIC.
#
# Vì sao public: URL của file được lưu thẳng vào messages.content và hiển thị lại
# nhiều ngày sau, trong khi signed URL của Supabase luôn có hạn — link lưu trong DB
# sẽ chết. Đường dẫn file có chứa UUID ngẫu nhiên nên không đoán được, đây cũng là
# cách Cloudinary phục vụ ảnh. Muốn siết chặt hơn thì đổi bucket sang private và
# thêm một endpoint ở BE kiểm tra quyền rồi 302 sang signed URL sinh tại chỗ.
# SUPABASE_BUCKET=chat-attachments

# --- Tài liệu khoá học (chỉ dùng khi chạy seed) ---
# Khoá học tự soạn nằm trong repo tại content/courses nên không cần cấu hình gì.
# Biến dưới đây chỉ dành cho các khoá còn lấy từ kho tài liệu NGOÀI repo. Máy nào
# không có thư mục đó thì seed vẫn chạy, chỉ bỏ qua những khoá tương ứng.
# COURSE_DOCS_DIR=D:/duong/dan/toi/FinalProjectDocs/NodeJS_BE
